{
  "name": "dataforge-backend",
  "version": "1.0.0",
  "description": "DataForge - Dataset, Model, and Experiment Lineage Management DBMS Backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
